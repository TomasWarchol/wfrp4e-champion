<div class="champion-chat-card dossier-chat-card">
  <div class="chat-card-header">
    <div class="header-icon"><i class="fas fa-crown"></i></div>
    <div class="header-titles">
      <h3 class="card-title">{{localize "CHAMPION.Chat.DossierTitle"}}</h3>
      <div class="card-subtitle">{{courtName}}</div>
    </div>
  </div>

  <div class="chat-protagonists">
    <div class="protagonist wzywajacy">
      <img src="{{pinnedImg}}" alt="{{pinnedName}}" class="avatar-img" />
      <div class="protagonist-details">
        <span class="role-label">{{relationshipLabel}}:</span>
        <strong class="name">{{pinnedName}}</strong>
        <small class="status-tag">{{pinnedStatus}}</small>
      </div>
    </div>
    <div class="favor-badge-col">
      <span class="favor-count-label">{{localize "CHAMPION.Chat.FavorsLeft"}}</span>
      <strong class="favor-count-val">{{remainingFavors}} / 5</strong>
    </div>
  </div>

  <div class="chat-section demand-section">
    <div class="section-title"><i class="fas fa-bullhorn"></i> {{localize "CHAMPION.Chat.Demand"}}</div>
    <div class="section-body callout-body">
      „{{demandText}}”
    </div>
  </div>

  {{#if hooks}}
    <div class="chat-section hooks-section">
      <div class="section-title"><i class="fas fa-key"></i> {{localize "CHAMPION.Chat.HookUsed"}}</div>
      <div class="section-body">{{hooks}}</div>
    </div>
  {{/if}}

  <div class="chat-footer-flavor">
    <em>{{localize "CHAMPION.Chat.DossierFlavor"}}</em>
  </div>
</div>
