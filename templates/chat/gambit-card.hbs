<div class="champion-chat-card gambit-chat-card">
  <div class="chat-card-header">
    <div class="header-icon"><i class="fas fa-swords"></i></div>
    <div class="header-titles">
      <h3 class="card-title">{{localize "CHAMPION.Chat.GambitTitle"}}</h3>
      <div class="card-subtitle">{{gambitName}} ({{categoryLabel}})</div>
    </div>
  </div>

  <div class="chat-actor-line">
    <img src="{{actorImg}}" alt="{{actorName}}" class="avatar-small" />
    <span><strong>{{actorName}}</strong> {{localize "CHAMPION.Chat.GambitLine" stance=stanceName}}</span>
  </div>

  <div class="gambit-chat-costs">
    <span class="cost-tag adv"><i class="fas fa-bolt"></i> {{localize "CHAMPION.Chat.Cost" cost=costAdvantage}}</span>
    <span class="stance-tag"><i class="fas fa-shield"></i> {{stanceSchool}}</span>
  </div>

  <div class="chat-section test-section">
    <div class="section-title"><i class="fas fa-dice"></i> {{localize "CHAMPION.Chat.RequiredTest"}}</div>
    <div class="section-body test-body">
      <strong>{{opposedTest}}</strong>
    </div>
  </div>

  <div class="chat-section effect-section">
    <div class="section-title"><i class="fas fa-burst"></i> {{localize "CHAMPION.Chat.Effects"}}</div>
    <div class="section-body">{{effect}}</div>
  </div>

  <div class="chat-footer-flavor">
    <small>{{localize "CHAMPION.Chat.RemainingAdvantage"}} <strong>{{remainingAdvantage}}</strong></small>
  </div>
</div>
