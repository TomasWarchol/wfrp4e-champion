<div class="champion-chat-card challenge-chat-card">
  <div class="chat-card-header">
    <div class="header-icon"><i class="fas {{scaleIcon}}"></i></div>
    <div class="header-titles">
      <h3 class="card-title">{{localize "CHAMPION.Chat.ChallengeTitle"}}</h3>
      <div class="card-subtitle">{{scaleLabel}}</div>
    </div>
  </div>

  <div class="chat-protagonists">
    <div class="protagonist wzywajacy">
      <img src="{{actorImg}}" alt="{{actorName}}" class="avatar-img" />
      <div class="protagonist-details">
        <span class="role-label">{{localize "CHAMPION.Chat.Challenger"}}</span>
        <strong class="name">{{actorName}}</strong>
        <small class="mandate-tag">{{localize "CHAMPION.Chat.MandateTag" value=(champFormatMandate mandate)}}</small>
      </div>
    </div>
    <div class="vs-divider">VS</div>
    <div class="protagonist cel">
      <div class="avatar-placeholder"><i class="fas fa-user-shield"></i></div>
      <div class="protagonist-details">
        <span class="role-label">{{localize "CHAMPION.Chat.Target"}}</span>
        <strong class="name">{{targetName}}</strong>
        <small class="status-tag">{{targetStatus}}</small>
      </div>
    </div>
  </div>

  <div class="chat-section stakes-section">
    <div class="section-title"><i class="fas fa-scale-unbalanced-flip"></i> {{localize "CHAMPION.Chat.Stakes"}}</div>
    <div class="section-body">{{stakes}}</div>
  </div>

  <div class="chat-section conditions-section">
    <div class="section-title"><i class="fas fa-list-check"></i> {{localize "CHAMPION.Chat.Conditions"}}</div>
    <div class="section-body">{{conditions}}</div>
  </div>

  {{#if weaknesses.length}}
    <div class="chat-section weaknesses-section">
      <div class="section-title"><i class="fas fa-magnifying-glass"></i> {{localize "CHAMPION.Chat.Weaknesses"}}</div>
      <div class="weaknesses-tags">
        {{#each weaknesses}}
          <span class="chat-tag weakness"><i class="fas fa-crosshairs"></i> {{this}}</span>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <div class="chat-footer-flavor">
    <em>{{localize "CHAMPION.Chat.ChallengeFlavor"}}</em>
  </div>
</div>
