<div class="champion-sheet-root">
  {{!-- Górny HUD: Aktywna Postawa, Mandat Krwi, Chłopski Mir, Przewagi --}}
  {{> "modules/wfrp4e-champion/templates/parts/header-hud.hbs"}}

  {{!-- Pasek Głównych Zakładek --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="combat"><i class="fas fa-swords"></i> {{localize "CHAMPION.Tabs.Combat"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="courts"><i class="fas fa-crown"></i> {{localize "CHAMPION.Tabs.Courts"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="challenge"><i class="fas fa-gavel"></i> {{localize "CHAMPION.Tabs.Challenge"}}</a>
  </nav>

  {{!-- Ciało Okna --}}
  <section class="sheet-body">
    {{!-- Zakładka 1: Walka i Postawy --}}
    <div class="tab" data-group="primary" data-tab="combat">
      {{> "modules/wfrp4e-champion/templates/parts/gambits-tab.hbs"}}
    </div>

    {{!-- Zakładka 2: Wielodworski System Wpływów --}}
    <div class="tab" data-group="primary" data-tab="courts">
      {{> "modules/wfrp4e-champion/templates/parts/dossier-tab.hbs"}}
    </div>

    {{!-- Zakładka 3: Rytuał Wyzwania --}}
    <div class="tab" data-group="primary" data-tab="challenge">
      {{> "modules/wfrp4e-champion/templates/parts/challenge-tab.hbs"}}
    </div>
  </section>
</div>
