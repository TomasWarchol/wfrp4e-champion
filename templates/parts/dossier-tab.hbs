<div class="champion-tab-content courts-content">
  {{!-- 1. Pasek Wyboru Dworu --}}
  <div class="courts-nav-bar">
    <div class="courts-tabs-list">
      {{#each champ.courts}}
        <button type="button" class="court-tab-btn {{#if (bajeryEq this.id ../champ.activeCourtId)}}active{{/if}}" data-action="select-court" data-court-id="{{this.id}}">
          <i class="fas fa-crown"></i> {{this.name}}
          <span class="court-inf-pill">{{this.influence}}%</span>
        </button>
      {{/each}}
      <button type="button" class="btn-add-court" data-action="add-court" title="{{localize "CHAMPION.Courts.AddTooltip"}}">
        <i class="fas fa-plus"></i> {{localize "CHAMPION.Courts.Add"}}
      </button>
    </div>
  </div>

  {{!-- 2. Nagłówek Aktywnego Dworu --}}
  {{#if activeCourt}}
    <div class="active-court-header">
      <div class="court-title-row">
        <h3 class="court-heading"><i class="fas fa-landmark"></i> {{activeCourt.name}}</h3>
        <div class="court-influence-box">
          <span class="inf-label">{{localize "CHAMPION.Courts.Influence"}}</span>
          <input type="number" name="courtInfluence" data-court-id="{{activeCourt.id}}" value="{{activeCourt.influence}}" min="0" max="100" class="court-inf-input" />
          <span class="inf-denom">%</span>
          <button type="button" class="btn-icon danger" data-action="delete-court" data-court-id="{{activeCourt.id}}" title="{{localize "CHAMPION.Courts.DeleteTooltip"}}"><i class="fas fa-trash"></i></button>
        </div>
      </div>
      <div class="court-desc-text">{{activeCourt.description}}</div>
    </div>

    {{!-- 3. Dropzone dla Aktorów z Foundry --}}
    <div class="court-pinned-dropzone">
      <i class="fas fa-user-plus dropzone-icon"></i>
      <span>{{localize "CHAMPION.Courts.DropZone"}}</span>
    </div>

    {{!-- 4. Lista Przypiętych Aktorów --}}
    <div class="pinned-actors-list">
      {{#each activeCourt.pinnedActors}}
        <div class="pinned-actor-card rel-{{this.relationship}}">
          <div class="pinned-avatar-col">
            <img src="{{this.img}}" alt="{{this.name}}" class="pinned-img" />
          </div>

          <div class="pinned-info-col">
            <div class="pinned-header-line">
              <strong class="pinned-name">{{this.name}}</strong>
              <span class="pinned-status-badge">{{this.status}}</span>
              <span class="pinned-rel-badge {{this.relationship}}">{{this.relationshipLabel}}</span>
            </div>

            {{!-- Licznik Długów / Przysług --}}
            <div class="pinned-favors-row">
              <span class="favors-label"><i class="fas fa-handshake"></i> {{localize "CHAMPION.Courts.Favors"}}</span>
              <div class="favors-controls">
                <button type="button" class="btn-micro" data-action="modify-favor" data-court-id="{{../activeCourt.id}}" data-pinned-id="{{this.id}}" data-delta="-1" title="{{localize "CHAMPION.Courts.FavorDown"}}"><i class="fas fa-minus"></i></button>
                <div class="favor-pips">
                  {{#bajeryTimes 5}}
                    <span class="favor-pip {{#if (bajeryLt this ../this.favors)}}filled{{/if}}"></span>
                  {{/bajeryTimes}}
                </div>
                <span class="favor-count">({{this.favors}}/5)</span>
                <button type="button" class="btn-micro" data-action="modify-favor" data-court-id="{{../activeCourt.id}}" data-pinned-id="{{this.id}}" data-delta="1" title="{{localize "CHAMPION.Courts.FavorUp"}}"><i class="fas fa-plus"></i></button>
              </div>
            </div>

            {{!-- Haki i Sekrety --}}
            {{#if this.hooks}}
              <div class="pinned-hooks-box">
                <small><strong>{{localize "CHAMPION.Courts.Hooks"}}</strong> {{this.hooks}}</small>
              </div>
            {{/if}}

            {{#if this.notes}}
              <div class="pinned-notes-box">
                <small><strong>{{localize "CHAMPION.Courts.Notes"}}</strong> {{this.notes}}</small>
              </div>
            {{/if}}
          </div>

          <div class="pinned-actions-col">
            <button type="button" class="btn-use-favor" data-action="use-favor" data-court-id="{{../activeCourt.id}}" data-pinned-id="{{this.id}}" title="{{localize "CHAMPION.Courts.UseTooltip"}}">
              <i class="fas fa-bullhorn"></i> {{localize "CHAMPION.Courts.Use"}}
            </button>
            <div class="pinned-micro-tools">
              <button type="button" class="btn-icon" data-action="edit-pinned" data-court-id="{{../activeCourt.id}}" data-pinned-id="{{this.id}}" title="{{localize "CHAMPION.Courts.EditTooltip"}}"><i class="fas fa-pencil"></i></button>
              <button type="button" class="btn-icon danger" data-action="delete-pinned" data-court-id="{{../activeCourt.id}}" data-pinned-id="{{this.id}}" title="{{localize "CHAMPION.Courts.RemoveTooltip"}}"><i class="fas fa-trash"></i></button>
            </div>
          </div>
        </div>
      {{/each}}

      {{#unless activeCourt.pinnedActors.length}}
        <div class="no-pinned-actors">
          <em>{{localize "CHAMPION.Courts.Empty"}}</em>
        </div>
      {{/unless}}
    </div>
  {{/if}}
</div>
