<div class="lg-petitions">
  <div class="lg-section-head">
    <h2><i class="fa-solid fa-hands-praying"></i> {{localize "CHAMPION.Petitions.Title"}}</h2>
    <div class="lg-promises" data-tooltip="{{localize 'CHAMPION.Petitions.PromisesHint'}}">
      <span>{{localize "CHAMPION.Petitions.Promises"}}</span>
      {{#each petitions.promiseSlots}}<span class="lg-wax {{#if this}}is-on{{/if}}"></span>{{/each}}
    </div>
    {{#if env.canEdit}}<button type="button" class="lg-btn lg-btn--gold" data-action="addPetition"><i class="fa-solid fa-plus"></i> {{localize "CHAMPION.Petitions.Add"}}</button>{{/if}}
  </div>

  <div class="lg-board" data-drop="petition">
    {{#if petitions.isEmpty}}
    <div class="lg-empty lg-empty--board">
      <i class="fa-solid fa-thumbtack"></i>
      <p>{{localize "CHAMPION.Petitions.Empty"}}</p>
    </div>
    {{/if}}

    {{#each petitions.accepted}}
    <article class="lg-note is-accepted {{urgency}}" style="--tilt:{{tilt}}deg">
      <span class="lg-pin"></span>
      <div class="lg-note-seal" data-tooltip="{{localize 'CHAMPION.Petitions.Status.accepted'}}"><i class="fa-solid fa-handshake"></i></div>
      {{> "modules/wfrp4e-champion/templates/parts/petition-body.hbs" canEdit=../env.canEdit}}
      {{#if ../env.canEdit}}
      <footer class="lg-note-actions">
        <button type="button" class="lg-btn lg-btn--gold lg-btn--sm" data-action="petition" data-op="fulfill" data-petition-id="{{id}}"><i class="fa-solid fa-check"></i> {{localize "CHAMPION.Petitions.Fulfill"}}</button>
        <button type="button" class="lg-btn lg-btn--blood lg-btn--sm" data-action="petition" data-op="fail" data-petition-id="{{id}}"><i class="fa-solid fa-heart-crack"></i> {{localize "CHAMPION.Petitions.Fail"}}</button>
      </footer>
      {{/if}}
    </article>
    {{/each}}

    {{#each petitions.open}}
    <article class="lg-note {{urgency}}" style="--tilt:{{tilt}}deg">
      <span class="lg-pin"></span>
      {{> "modules/wfrp4e-champion/templates/parts/petition-body.hbs" canEdit=../env.canEdit}}
      {{#if ../env.canEdit}}
      <footer class="lg-note-actions">
        <button type="button" class="lg-btn lg-btn--gold lg-btn--sm" data-action="petition" data-op="accept" data-petition-id="{{id}}" {{#unless ../petitions.canAccept}}disabled data-tooltip="{{localize 'CHAMPION.Petitions.TooMany'}}"{{/unless}}><i class="fa-solid fa-handshake"></i> {{localize "CHAMPION.Petitions.Accept"}}</button>
        <button type="button" class="lg-btn lg-btn--ghost-dark lg-btn--sm" data-action="petition" data-op="decline" data-petition-id="{{id}}" data-tooltip="{{localize 'CHAMPION.Petitions.DeclineHint'}}"><i class="fa-solid fa-hand"></i> {{localize "CHAMPION.Petitions.Decline"}}</button>
      </footer>
      {{/if}}
    </article>
    {{/each}}
  </div>

  {{#if petitions.archive.length}}
  <details class="lg-archive">
    <summary><i class="fa-solid fa-box-archive"></i> {{localize "CHAMPION.Petitions.Archive"}} ({{petitions.archive.length}})</summary>
    <ul>
      {{#each petitions.archive}}
      <li class="is-{{status}}">
        <span class="lg-archive-status">{{statusLabel}}</span>
        <b>{{petitioner}}</b>
        <span class="lg-archive-text">{{request}}</span>
        {{#if resolvedLabel}}<small>{{resolvedLabel}}</small>{{/if}}
        {{#if ../env.canEdit}}<button type="button" class="lg-icon-btn" data-action="deletePetition" data-petition-id="{{id}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </li>
      {{/each}}
    </ul>
  </details>
  {{/if}}

  <details class="lg-howto">
    <summary><i class="fa-solid fa-circle-question"></i> {{localize "CHAMPION.HowTo"}}</summary>
    <div class="lg-howto-body">{{{localize "CHAMPION.Petitions.HowTo"}}}</div>
  </details>
</div>
