<div class="champion-tab-content challenge-content">
  <div class="section-banner">
    <div class="banner-title"><i class="fas fa-gavel"></i> {{localize "CHAMPION.Challenge.Banner"}}</div>
    <div class="banner-desc">{{localize "CHAMPION.Challenge.BannerDesc"}}</div>
  </div>

  {{!-- 1. Skala Starcia --}}
  <div class="form-group scale-selector-group">
    <label class="group-title"><i class="fas fa-compass"></i> {{localize "CHAMPION.Challenge.Scale"}}</label>
    <div class="scale-buttons-grid">
      <button type="button" class="scale-btn {{#if (bajeryEq champ.challengeScale 'personal')}}active{{/if}}" data-action="set-scale" data-scale="personal">
        <i class="fas fa-gavel"></i>
        <strong>{{localize "CHAMPION.Scale.personal.Title"}}</strong>
        <small>{{localize "CHAMPION.Scale.personal.Desc"}}</small>
      </button>

      <button type="button" class="scale-btn {{#if (bajeryEq champ.challengeScale 'tactical')}}active{{/if}}" data-action="set-scale" data-scale="tactical">
        <i class="fas fa-shield-halved"></i>
        <strong>{{localize "CHAMPION.Scale.tactical.Title"}}</strong>
        <small>{{localize "CHAMPION.Scale.tactical.Desc"}}</small>
      </button>

      <button type="button" class="scale-btn {{#if (bajeryEq champ.challengeScale 'strategic')}}active{{/if}}" data-action="set-scale" data-scale="strategic">
        <i class="fas fa-flag"></i>
        <strong>{{localize "CHAMPION.Scale.strategic.Title"}}</strong>
        <small>{{localize "CHAMPION.Scale.strategic.Desc"}}</small>
      </button>
    </div>
  </div>

  {{!-- 2. Studium Rywala (Zwiad Przedpojedynkowy w TEW) --}}
  <div class="form-group rival-study-group">
    <label class="group-title"><i class="fas fa-magnifying-glass"></i> {{localize "CHAMPION.Challenge.Study"}}</label>
    <div class="target-inputs-row">
      <div class="input-col flex-2">
        <span class="sub-label">{{localize "CHAMPION.Challenge.RivalName"}}</span>
        <input type="text" name="rivalName" value="{{champ.rivalStudy.targetName}}" placeholder="{{localize "CHAMPION.Challenge.RivalNamePlaceholder"}}" />
      </div>
      <div class="input-col flex-1">
        <span class="sub-label">{{localize "CHAMPION.Challenge.RivalStatus"}}</span>
        <input type="text" name="rivalStatus" value="{{champ.rivalStudy.targetStatus}}" placeholder="{{localize "CHAMPION.Challenge.RivalStatusPlaceholder"}}" />
      </div>
    </div>

    <div class="weaknesses-chips-section">
      <span class="sub-label">{{localize "CHAMPION.Challenge.Weaknesses"}}</span>
      <div class="weaknesses-chips-wrapper">
        <span class="weakness-chip {{#if champ.rivalStudy.weaknesses.kneeInjury}}active{{/if}}" data-weakness="kneeInjury">
          <i class="fas fa-bone"></i> {{localize "CHAMPION.Weakness.kneeInjury"}}
        </span>
        <span class="weakness-chip {{#if champ.rivalStudy.weaknesses.hotTempered}}active{{/if}}" data-weakness="hotTempered">
          <i class="fas fa-fire"></i> {{localize "CHAMPION.Weakness.hotTempered"}}
        </span>
        <span class="weakness-chip {{#if champ.rivalStudy.weaknesses.bladePoisoner}}active{{/if}}" data-weakness="bladePoisoner">
          <i class="fas fa-flask"></i> {{localize "CHAMPION.Weakness.bladePoisoner"}}
        </span>
        <span class="weakness-chip {{#if champ.rivalStudy.weaknesses.superstitious}}active{{/if}}" data-weakness="superstitious">
          <i class="fas fa-ankh"></i> {{localize "CHAMPION.Weakness.superstitious"}}
        </span>
        <span class="weakness-chip {{#if champ.rivalStudy.weaknesses.rigidStyle}}active{{/if}}" data-weakness="rigidStyle">
          <i class="fas fa-book"></i> {{localize "CHAMPION.Weakness.rigidStyle"}}
        </span>
      </div>
      <div class="custom-weakness-row">
        <span class="sub-label">{{localize "CHAMPION.Challenge.CustomWeakness"}}</span>
        <input type="text" name="customWeakness" value="{{champ.rivalStudy.customWeakness}}" placeholder="{{localize "CHAMPION.Challenge.CustomWeaknessPlaceholder"}}" />
      </div>
    </div>
  </div>

  {{!-- 3. Stawka i Warunki --}}
  <div class="form-group stakes-group">
    <label class="group-title"><i class="fas fa-scale-unbalanced-flip"></i> {{localize "CHAMPION.Challenge.Stakes"}}</label>
    <textarea name="challengeStakes" rows="2" placeholder="{{localize "CHAMPION.Challenge.StakesPlaceholder"}}">{{champ.challengeStakes}}</textarea>
  </div>

  <div class="form-group conditions-group">
    <label class="group-title"><i class="fas fa-list-check"></i> {{localize "CHAMPION.Challenge.Conditions"}}</label>
    <input type="text" name="challengeConditions" value="{{champ.challengeConditions}}" placeholder="{{localize "CHAMPION.Challenge.ConditionsPlaceholder"}}" />
  </div>

  {{!-- Przycisk Rzucenia Rękawicy --}}
  <div class="challenge-submit-box">
    <button type="button" class="btn-post-challenge" data-action="post-challenge">
      <i class="fas fa-hand-back-fist"></i> {{localize "CHAMPION.Challenge.Post"}}
    </button>
  </div>
</div>
