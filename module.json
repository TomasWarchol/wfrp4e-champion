{
  "id": "wfrp4e-champion",
  "title": "WFRP4e – Iron Mandate: Champion's Legend",
  "description": "A legend system for a Champion character in Warhammer Fantasy Roleplay 4e: tales and fame, the Name the people give him, petitions, duels before the crowd with the party as seconds, rivals who remember, and inheritance when he falls. English and Polish.",
  "version": "2.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Tomek (TomasWarchol)",
      "url": "https://github.com/TomasWarchol",
      "discord": "tomek"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "wfrp4e",
        "type": "system",
        "compatibility": {
          "minimum": "9.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "wfrp4e-companion-lib",
        "type": "module",
        "manifest": "https://github.com/TomasWarchol/wfrp4e-companion-lib/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "1.0.0"
        }
      }
    ]
  },
  "esmodules": [
    "wfrp4e-champion.mjs"
  ],
  "styles": [
